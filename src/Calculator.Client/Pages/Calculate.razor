@page "/"
@page "/Calculate"
@using System.Globalization
@inject CalculatorService.CalculatorServiceClient CalculatorClient


<h3>Taschenrechner</h3>

<div class="calculator-container">
    <div class="form-group">
        <label for="operand1">Erste Zahl</label>
        <input id="operand1"
               type="number"
               class="form-control"
               @bind="Operand1"
               placeholder="z. B. 10" />
    </div>

    <div class="form-group">
        <label for="operation">Operation</label>
        <select id="operation"
                class="form-control"
                @bind="SelectedOperation">
            <option value="@Operation.Addition">Addition (+)</option>
            <option value="@Operation.Subtraction">Subtraktion (-)</option>
            <option value="@Operation.Multiplication">Multiplikation (*)</option>
            <option value="@Operation.Division">Division (/)</option>
        </select>
    </div>

    <div class="form-group">
        <label for="operand2">Zweite Zahl</label>
        <input id="operand2"
               type="number"
               class="form-control"
               @bind="Operand2"
               placeholder="z. B. 5" />
    </div>

    <button class="btn btn-primary"
            @onclick="CalculateAsync">
        Berechnen
    </button>

    <div class="result-box">
        <strong>Ergebnis:</strong>
        <span>@ResultText</span>
    </div>
</div>

@code {
    private double? Operand1 { get; set; }
    private double? Operand2 { get; set; }

    private Operation SelectedOperation { get; set; } = Operation.Addition;
    private string ResultText { get; set; } = "Noch kein Ergebnis";

    private async Task CalculateAsync()
    {
        if (Operand1 is null || Operand2 is null)
        {
            ResultText = "Bitte beide Zahlen eingeben.";
            return;
        }

        var response = await CalculatorClient.CalculateAsync(new CalculationRequest
        {
            Left = Operand1.Value,
            Right = Operand2.Value,
            Operation = SelectedOperation
        });

        ResultText = response.Code switch
        {
            CalculationResultCode.Ok => response.Value.ToString(CultureInfo.InvariantCulture),
            CalculationResultCode.DivisionByZero => "Fehler: Division durch 0.",
            _ => "Unbekannter Berechnungsfehler."
        };
    }
}